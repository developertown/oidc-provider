{
  "name": "@developertown/oidc-provider",
  "version": "1.3.2",
  "description": "React authentication provider built on oidc-client-ts, with first-class support for Auth0, Azure AD, and Amazon Cognito.",
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "pkce",
    "authentication",
    "authorization",
    "react",
    "react-hooks",
    "auth0",
    "azure-ad",
    "cognito",
    "oidc-client-ts"
  ],
  "homepage": "https://github.com/developertown/oidc-provider#readme",
  "bugs": {
    "url": "https://github.com/developertown/oidc-provider/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developertown/oidc-provider.git",
    "directory": "packages/oidc-provider"
  },
  "license": "MIT",
  "author": "DeveloperTown <opensource@developertown.com> (https://developertown.com)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "clean": "rimraf ./dist",
    "dev": "bunchee --watch",
    "license:add": "license_finder licenses add",
    "license:approve-package": "license_finder approvals add",
    "license:check": "license_finder",
    "license:permit": "license_finder permitted_licenses add",
    "lint": "eslint .",
    "lint:fix": "yarn run lint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "typescript-fsa": "^3.0.0",
    "typescript-fsa-reducers": "^1.2.2"
  },
  "devDependencies": {
    "@developertown/eslint-config": "*",
    "@developertown/typescript-config": "*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "bunchee": "^7.0.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.1.0 || ^19.0.0",
    "react-dom": "^18.1.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
