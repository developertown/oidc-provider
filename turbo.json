{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/__tests__/**", "!**/*.test.*", "!**/*.spec.*"],
      "outputs": ["dist/**", "build/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../typescript-config/*.json"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "../eslint-config/*.js"],
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "license:check": {
      "cache": true
    }
  }
}
